{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/llm/tool-calls/v1",
  "title": "LLM Tool Calls v1",
  "description": "The complete ordered collection of parallel tool call batches returned by a model. Calls within each parallel tool call batch may run concurrently; outer batches execute sequentially.",
  "type": "array",
  "maxItems": 10,
  "uniqueItems": true,
  "items": {"$ref": "#/$defs/ParallelToolCallBatch"},
  "$defs": {
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "description": "One normalized call in a parallel tool call batch.",
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "description": "Call identifier.", "examples": ["call-read-1"]},
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$", "description": "Declared tool name.", "examples": ["read_record"]},
        "arguments": {"type": "object", "description": "Parsed and validated tool arguments.", "examples": [{"logicalId": "record-a"}]}
      },
      "examples": [{"id": "call-read-1", "name": "read_record", "arguments": {"logicalId": "record-a"}}]
    },
    "ParallelToolCallBatch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "One parallel tool call batch. Calls in this array may be invoked concurrently.",
      "items": {"$ref": "#/$defs/ToolCall"},
      "examples": [[{"id": "call-read-1", "name": "read_record", "arguments": {"logicalId": "record-a"}}]]
    }
  },
  "examples": [
    [
      [
        {"id": "call-read-1", "name": "read_record", "arguments": {"logicalId": "record-a"}},
        {"id": "call-read-2", "name": "read_record", "arguments": {"logicalId": "record-b"}}
      ],
      [
        {"id": "call-compare-1", "name": "compare_records", "arguments": {"left": "record-a", "right": "record-b"}}
      ]
    ]
  ]
}