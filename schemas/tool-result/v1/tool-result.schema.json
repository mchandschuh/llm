{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/llm/tool-result/v1",
  "title": "LLM Tool Result v1",
  "description": "A bounded transient result associated with one validated tool call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["callId", "name", "status"],
  "properties": {
    "callId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "description": "Call identifier being completed.", "examples": ["call-read-1"]},
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$", "description": "Tool name that produced this result.", "examples": ["read_record"]},
    "status": {"type": "string", "enum": ["success", "error"], "description": "Whether the invoker completed successfully.", "examples": ["success"]},
    "value": {"description": "JSON-serializable bounded tool value, present for successful calls.", "examples": [{"logicalId": "record-a"}]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$", "description": "Stable sanitized tool failure code.", "examples": ["TOOL_FAILED"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Bounded sanitized tool failure message.", "examples": ["The tool failed."]}
      },
      "description": "Bounded error returned when status is error.",
      "examples": [{"code": "TOOL_FAILED", "message": "The tool failed."}]
    }
  },
  "examples": [{"callId": "call-read-1", "name": "read_record", "status": "success", "value": {"logicalId": "record-a"}}]
}