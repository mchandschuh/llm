{
  "name": "llm",
  "version": "0.3.1",
  "description": "Provider-agnostic structured LLM completion CLI and library.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llm": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "schemas/"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node ./bin/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/support/claude-guard.ts --test tests/*.test.ts",
    "test:pattern": "tsx --import ./tests/support/claude-guard.ts --test tests/*.test.ts --test-name-pattern",
    "test:live:claude": "npm run build && node tests/live/claude-live.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "nodejs-common": "file:../nodejs-common",
    "schema-validate": "file:../json-schema-authoring"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED"
}
